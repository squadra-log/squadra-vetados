rules_version = '2';
// Reglas de seguridad de Squadra Vetados.
// Sin una cuenta activa no se puede leer ni escribir nada.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function cuentaPath() { return /databases/$(database)/documents/cuentas/$(request.auth.uid); }
    function tieneCuenta() { return signedIn() && exists(cuentaPath()); }
    function yo() { return get(cuentaPath()).data; }
    function activo() { return tieneCuenta() && yo().activo == true; }
    function admin() { return activo() && yo().rol in ['admin', 'supremo']; }
    function soporte() { return activo() && yo().rol == 'supremo'; }
    function listoPath() { return /databases/$(database)/documents/sistema/listo; }

    // Marca de que ya se creó la primera cuenta de Soporte
    match /sistema/listo {
      allow read: if true;
      allow create: if signedIn() && !exists(listoPath())
        && getAfter(cuentaPath()).data.rol == 'supremo';
      allow update, delete: if false;
    }

    // Nombres de locales (los edita Soporte)
    match /sistema/locales {
      allow read: if activo();
      allow write: if soporte();
    }

    // Usuario -> correo interno de acceso (se usa al entrar; no se puede listar)
    match /usuarios/{u} {
      allow get: if true;
      allow list: if false;
      allow write: if soporte()
        || (signedIn() && !exists(listoPath()) && existsAfter(listoPath()));
    }

    match /cuentas/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || soporte());
      // Soporte crea cuentas; o la primera cuenta de Soporte durante la configuración inicial
      allow create: if soporte()
        || (signedIn() && request.auth.uid == uid
            && !exists(listoPath()) && existsAfter(listoPath())
            && request.resource.data.rol == 'supremo' && request.resource.data.activo == true);
      allow update, delete: if soporte();
    }

    // Dispositivos donde cada cuenta tiene la sesión iniciada
    match /cuentas/{uid}/dispositivos/{did} {
      allow read: if signedIn() && (request.auth.uid == uid || soporte());
      allow create, update: if signedIn() && request.auth.uid == uid && activo();
      allow delete: if signedIn() && (request.auth.uid == uid || soporte());
    }
    match /{path=**}/dispositivos/{did} {
      allow read: if soporte();
    }

    match /personas/{pid} {
      allow read: if activo();
      allow create, update: if admin();
      allow delete: if soporte();
      match /fotos/{fid} {
        allow read: if activo();
        allow create, update, delete: if admin();
      }
    }
  }
}
